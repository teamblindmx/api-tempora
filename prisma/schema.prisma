// Tablas de Tempora (esquema app). Las compañías, negocios, sedes y usuarios viven en Axeda,
// esquema auth: aquí se guardan sus identificadores como texto, sin claves foráneas entre esquemas
// (ADR 0006, ADR 0007).
//
// Toda tabla de negocio lleva company_id y una política RLS (se escribe a mano en la migración: Prisma
// no modela políticas). La prueba test/rls.e2e-spec.ts falla si una tabla no la tiene.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

/// Datos de Tempora de una sede de Axeda: ubicación y radio para validar el marcado (ADR 0007).
/// La sede (nombre, estado, negocio) vive en Axeda; id es el id de la sede en Axeda. company_id y
/// business_id se copian de Axeda al guardar, leídos de su base, nunca del cliente.
model Site {
  id               String   @id
  companyId        String   @map("company_id")
  businessId       String?  @map("business_id")
  latitude         Decimal  @db.Decimal(9, 6)
  longitude        Decimal  @db.Decimal(9, 6)
  radiusM          Int      @default(500) @map("radius_m")
  timezone         String   @default("America/Mexico_City")
  /// Horario oficial de la sede, "HH:MM" en su zona horaria. Null mientras no se defina
  /// (pregunta abierta 4 del PRD): sin cierre, la salida no se clasifica por horario.
  shiftStart       String?  @map("shift_start")
  shiftEnd         String?  @map("shift_end")
  /// Minutos de tolerancia después de la entrada oficial antes de contar retardo (ADR 0014).
  lateToleranceMin Int      @default(10) @map("late_tolerance_min")
  /// Días de descanso semanal de la sede: 0 = domingo ... 6 = sábado (regla 16; por cuadrilla, después).
  restDays         Int[]    @default([0]) @map("rest_days")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employees      EmployeeProfile[]
  dailyCodes     DailyCode[]
  attendance     AttendanceRecord[]
  holidays       Holiday[]
  justifications Justification[]
  overtime       OvertimeAuthorization[]
  corrections    AttendanceCorrection[]
  notices        Notice[]

  @@unique([id, companyId])
  @@index([companyId])
  @@map("site")
  @@schema("app")
}

/// Datos de recursos humanos de un empleado. El empleado es un usuario de Axeda (userId).
model EmployeeProfile {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id")
  userId     String   @map("user_id")
  siteId     String?  @map("site_id")
  department String?
  position   String?
  photoUrl   String?  @map("photo_url")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // FK compuesta: un perfil nunca apunta a una sede de otra compañía (las FK no pasan por RLS).
  site Site? @relation(fields: [siteId, companyId], references: [id, companyId])

  @@unique([companyId, userId])
  @@index([companyId])
  @@map("employee_profile")
  @@schema("app")
}

/// Auditoría de solo inserción: el rol de la API no tiene UPDATE ni DELETE, y un trigger lo impide
/// también al dueño.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  companyId   String   @map("company_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  targetType  String   @map("target_type")
  targetId    String?  @map("target_id")
  before      Json?
  after       Json?
  reason      String?
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(3)

  @@index([companyId, occurredAt])
  @@map("audit_log")
  @@schema("app")
}

/// Código diario de una sede (regla 2): lo genera el líder y dura de 20 a 30 minutos. Al generar uno
/// nuevo, el anterior vence. Se conserva para saber con qué código marcó cada quien.
model DailyCode {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id")
  siteId    String   @map("site_id")
  code      String
  createdBy String   @map("created_by")
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  site       Site               @relation(fields: [siteId, companyId], references: [id, companyId])
  attendance AttendanceRecord[]

  @@unique([id, companyId])
  @@index([companyId, siteId, expiresAt])
  @@map("daily_code")
  @@schema("app")
}

/// Una jornada de un trabajador: su entrada y su salida. La hora la pone el servidor (regla 1).
/// Una por trabajador y día de jornada (fecha local de la sede al entrar). No se borra: la API no
/// tiene DELETE sobre esta tabla. Entrada y salida dicen quién las registró: el propio trabajador
/// ("self") o el líder por él ("manual", con autor y comentario obligatorio; ADR 0013).
model AttendanceRecord {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id")
  siteId    String   @map("site_id")
  /// Usuario de Axeda.
  userId    String   @map("user_id")
  workDate  DateTime @map("work_date") @db.Date

  checkInAt        DateTime @map("check_in_at") @db.Timestamptz(3)
  checkInLatitude  Decimal? @map("check_in_latitude") @db.Decimal(9, 6)
  checkInLongitude Decimal? @map("check_in_longitude") @db.Decimal(9, 6)
  checkInAccuracyM Int?     @map("check_in_accuracy_m")
  /// Distancia real a la sede (regla 4), para afinar el radio. Null si no hubo ubicación.
  checkInDistanceM Int?     @map("check_in_distance_m")
  /// Código con que marcó. Null solo en una entrada manual del líder.
  dailyCodeId      String?  @map("daily_code_id") @db.Uuid
  /// "self" (el trabajador, con código) o "manual" (el líder por él).
  checkInSource    String   @default("self") @map("check_in_source")
  /// Usuario de Axeda que registró una entrada manual.
  checkInBy        String?  @map("check_in_by")
  /// Comentario obligatorio de una entrada manual.
  checkInComment   String?  @map("check_in_comment")

  checkOutAt        DateTime? @map("check_out_at") @db.Timestamptz(3)
  checkOutLatitude  Decimal?  @map("check_out_latitude") @db.Decimal(9, 6)
  checkOutLongitude Decimal?  @map("check_out_longitude") @db.Decimal(9, 6)
  checkOutAccuracyM Int?      @map("check_out_accuracy_m")
  checkOutDistanceM Int?      @map("check_out_distance_m")
  /// "regular" o "early" (regla 6).
  checkOutKind      String?   @map("check_out_kind")
  /// Motivo de una salida anticipada (obligatorio en ese caso).
  checkOutReason    String?   @map("check_out_reason")
  /// "self" o "manual". Null mientras no haya salida.
  checkOutSource    String?   @map("check_out_source")
  checkOutBy        String?   @map("check_out_by")
  checkOutComment   String?   @map("check_out_comment")

  /// Retardo (regla 10, ADR 0014), decidido al registrar la entrada con el horario y la tolerancia
  /// de ese momento. No cuenta en un día de descanso o festivo.
  checkInLate        Boolean @default(false) @map("check_in_late")
  /// Minutos después de la entrada oficial (0 si llegó antes). Null si la sede no tenía horario.
  checkInLateMinutes Int?    @map("check_in_late_minutes")
  /// "Registrar entrada tardía": entró con un código de hoy que ya había vencido (regla 10).
  checkInCodeExpired Boolean @default(false) @map("check_in_code_expired")

  /// Motivos de "por revisar" (ver rules/marking.ts). Vacío: no hay nada que revisar.
  reviewReasons   String[]  @default([]) @map("review_reasons")
  /// Motivos que el líder ya revisó (ADR 0015). Queda "por revisar" lo que esté en reviewReasons y
  /// no aquí: si la salida agrega un motivo nuevo después de revisar la entrada, vuelve a la lista.
  reviewedReasons String[]  @default([]) @map("reviewed_reasons")
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(3)
  reviewedBy      String?   @map("reviewed_by")
  reviewComment   String?   @map("review_comment")
  /// Última corrección de horas (el historial completo está en attendance_correction).
  correctedAt     DateTime? @map("corrected_at") @db.Timestamptz(3)
  correctedBy     String?   @map("corrected_by")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // FK compuestas: una jornada nunca apunta a una sede o a un código de otra compañía.
  site           Site                   @relation(fields: [siteId, companyId], references: [id, companyId])
  dailyCode      DailyCode?             @relation(fields: [dailyCodeId, companyId], references: [id, companyId])
  justifications Justification[]
  corrections    AttendanceCorrection[]
  notices        Notice[]

  @@unique([id, companyId])
  @@unique([companyId, userId, workDate])
  @@index([companyId, siteId, workDate])
  @@index([companyId, workDate])
  @@map("attendance_record")
  @@schema("app")
}

/// Día festivo (regla 15). Sin sede, vale en todas las sedes de la compañía; con sede, solo en esa.
/// Es configuración, no evidencia: se puede borrar (queda en la auditoría).
model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id")
  siteId    String?  @map("site_id")
  date      DateTime @db.Date
  name      String
  /// "statutory" (art. 74 de la LFT, cargado por la API) o "custom" (lo agregó un administrador).
  source    String   @default("custom")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  site Site? @relation(fields: [siteId, companyId], references: [id, companyId])

  /// NULLS NOT DISTINCT (a mano en la migración): un solo festivo de compañía por fecha.
  @@unique([companyId, siteId, date])
  @@index([companyId, date])
  @@map("holiday")
  @@schema("app")
}

/// Justificación de un retardo, una salida anticipada o una falta (regla 12, versión simple): el
/// trabajador la escribe y el líder la aprueba o la rechaza. Una por día y tipo; el rechazo es final
/// hasta que exista la disputa con Recursos Humanos (después del 1 de enero). No se borra.
model Justification {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @map("company_id")
  siteId             String    @map("site_id")
  /// El trabajador (usuario de Axeda).
  userId             String    @map("user_id")
  workDate           DateTime  @map("work_date") @db.Date
  /// "late", "early-exit" o "absence".
  kind               String
  /// La jornada que justifica. Null en una falta.
  attendanceRecordId String?   @map("attendance_record_id") @db.Uuid
  reason             String
  submittedBy        String    @map("submitted_by")
  submittedAt        DateTime  @map("submitted_at") @db.Timestamptz(3)
  /// "pending", "approved" o "rejected".
  status             String    @default("pending")
  resolvedBy         String?   @map("resolved_by")
  resolvedAt         DateTime? @map("resolved_at") @db.Timestamptz(3)
  /// Comentario del líder; obligatorio al rechazar.
  resolutionComment  String?   @map("resolution_comment")

  site    Site              @relation(fields: [siteId, companyId], references: [id, companyId])
  record  AttendanceRecord? @relation(fields: [attendanceRecordId, companyId], references: [id, companyId])
  notices Notice[]

  @@unique([id, companyId])
  @@unique([companyId, userId, workDate, kind])
  @@index([companyId, siteId, status])
  @@map("justification")
  @@schema("app")
}

/// Autorización de horas extra (regla 9): el líder la da antes o en vivo, hasta una hora (`until`) o
/// como jornada abierta (sin `until`) que él cierra. Lo trabajado después del cierre de la
/// autorización es "tiempo no autorizado". Una por trabajador y día. Solo horas, no dinero.
model OvertimeAuthorization {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @map("company_id")
  siteId       String    @map("site_id")
  userId       String    @map("user_id")
  workDate     DateTime  @map("work_date") @db.Date
  /// Hasta qué hora. Null: jornada abierta, hasta que el líder la cierre.
  until        DateTime? @db.Timestamptz(3)
  reason       String
  authorizedBy String    @map("authorized_by")
  authorizedAt DateTime  @map("authorized_at") @db.Timestamptz(3)
  closedBy     String?   @map("closed_by")
  closedAt     DateTime? @map("closed_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  site Site @relation(fields: [siteId, companyId], references: [id, companyId])

  @@unique([companyId, userId, workDate])
  @@index([companyId, siteId, workDate])
  @@map("overtime_authorization")
  @@schema("app")
}

/// Aceptación del aviso de privacidad (requisito no funcional del PRD): quién, qué versión y cuándo.
/// Por compañía, porque el aviso es del patrón. Solo inserción: una versión nueva pide aceptar de nuevo.
model PrivacyAcceptance {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @map("company_id")
  userId     String   @map("user_id")
  version    String
  acceptedAt DateTime @map("accepted_at") @db.Timestamptz(3)
  ip         String?
  userAgent  String?  @map("user_agent")

  @@unique([companyId, userId, version])
  @@map("privacy_acceptance")
  @@schema("app")
}

/// Corrección de la hora de entrada o de salida de una jornada ya registrada (regla 13, ADR 0015):
/// quién, cuándo, por qué, y el valor anterior y el nuevo. Solo inserción: es el historial.
model AttendanceCorrection {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @map("company_id")
  siteId             String    @map("site_id")
  attendanceRecordId String    @map("attendance_record_id") @db.Uuid
  /// El trabajador de la jornada.
  userId             String    @map("user_id")
  correctedBy        String    @map("corrected_by")
  correctedAt        DateTime  @map("corrected_at") @db.Timestamptz(3)
  checkInBefore      DateTime  @map("check_in_before") @db.Timestamptz(3)
  checkInAfter       DateTime  @map("check_in_after") @db.Timestamptz(3)
  checkOutBefore     DateTime? @map("check_out_before") @db.Timestamptz(3)
  checkOutAfter      DateTime? @map("check_out_after") @db.Timestamptz(3)
  comment            String

  site   Site             @relation(fields: [siteId, companyId], references: [id, companyId])
  record AttendanceRecord @relation(fields: [attendanceRecordId, companyId], references: [id, companyId])

  @@index([companyId, attendanceRecordId])
  @@map("attendance_correction")
  @@schema("app")
}

/// Aviso para los líderes de una sede (regla 8, ADR 0015): una jornada quedó por revisar o llegó una
/// justificación. Es de la sede, no de una persona: cuando un líder lo atiende, deja de estar
/// pendiente para todos. Se atiende solo al revisar la jornada o resolver la justificación, o a mano.
/// Las notificaciones push llegan después del 1 de enero y saldrán de aquí.
model Notice {
  id                 String    @id @default(uuid()) @db.Uuid
  companyId          String    @map("company_id")
  siteId             String    @map("site_id")
  /// "attendance-review" o "justification".
  kind               String
  /// El trabajador del que trata el aviso.
  userId             String    @map("user_id")
  workDate           DateTime  @map("work_date") @db.Date
  attendanceRecordId String?   @map("attendance_record_id") @db.Uuid
  justificationId    String?   @map("justification_id") @db.Uuid
  /// Motivos de revisión o tipo de justificación, para mostrar el aviso sin otra consulta.
  detail             String[]  @default([])
  createdAt          DateTime  @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  readAt             DateTime? @map("read_at") @db.Timestamptz(3)
  readBy             String?   @map("read_by")

  site          Site              @relation(fields: [siteId, companyId], references: [id, companyId])
  record        AttendanceRecord? @relation(fields: [attendanceRecordId, companyId], references: [id, companyId])
  justification Justification?    @relation(fields: [justificationId, companyId], references: [id, companyId])

  @@index([companyId, siteId, readAt])
  @@map("notice")
  @@schema("app")
}
