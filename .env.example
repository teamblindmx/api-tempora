# Copia este archivo a .env. Nunca se commitea .env.
NODE_ENV=development
PORT=3000

# Datos de Tempora (esquema app), con el rol de la API: no es dueño de las tablas y no salta RLS.
DATABASE_URL=postgresql://tempora_app:app@localhost:5432/tempora
# Better Auth y Axeda (esquema auth), con su propio rol y pool.
DATABASE_URL_AUTH=postgresql://tempora_auth:auth@localhost:5432/tempora?options=-c%20search_path%3Dauth
# Solo para migraciones de Prisma (prisma.config.ts). La API no la usa.
DATABASE_URL_OWNER=postgresql://tempora_owner:owner@localhost:5432/tempora

# Al menos 32 caracteres aleatorios: openssl rand -base64 48
BETTER_AUTH_SECRET=
# URL pública de la API (en producción, https).
BETTER_AUTH_URL=http://localhost:3000
# Orígenes del frontend, separados por coma.
TRUSTED_ORIGINS=http://localhost:5173
# Dominio padre para compartir la cookie entre subdominios (p. ej. tempora.mx para app. y api.).
# Vacío en desarrollo.
COOKIE_DOMAIN=

# URL del frontend para los enlaces de las invitaciones. Vacío: el primer TRUSTED_ORIGINS.
APP_URL=
# Proveedor de SMS (códigos de acceso e invitaciones por teléfono). Solo "console" por ahora: imprime
# el mensaje. En producción la API no arranca con "console" hasta conectar un proveedor real.
SMS_PROVIDER=console

DB_POOL_MAX=10
AUTH_POOL_MAX=5
