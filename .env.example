# Copia este archivo a .env. Nunca se commitea .env.
NODE_ENV=development
PORT=3000

# Datos de Tempora (esquema app), con el rol de la API: no es dueño de las tablas y no salta RLS.
DATABASE_URL=postgresql://tempora_app:app@localhost:5432/tempora
# Better Auth y Axeda (esquema auth), con su propio rol y pool.
DATABASE_URL_AUTH=postgresql://tempora_auth:auth@localhost:5432/tempora?options=-c%20search_path%3Dauth
# Solo para migraciones de Prisma (prisma.config.ts). La API no la usa.
DATABASE_URL_OWNER=postgresql://tempora_owner:owner@localhost:5432/tempora

# Al menos 32 caracteres aleatorios: openssl rand -base64 48
BETTER_AUTH_SECRET=
# URL pública de la API (en producción, https).
BETTER_AUTH_URL=http://localhost:3000
# Orígenes del frontend, separados por coma.
TRUSTED_ORIGINS=http://localhost:5173
# Dominio padre para compartir la cookie entre subdominios (p. ej. tempora.mx para app. y api.).
# Vacío en desarrollo.
COOKIE_DOMAIN=

# URL del frontend para los enlaces de las invitaciones. Vacío: el primer TRUSTED_ORIGINS.
APP_URL=
# Proveedor de correo (verificación de cuenta e invitaciones): "console" imprime el correo (solo
# desarrollo; en producción la API no arranca con él) y "resend" lo envía (ADR 0017).
MAIL_PROVIDER=console
# Resend, solo con MAIL_PROVIDER=resend. Llave con permiso de solo envío, para el dominio verificado.
RESEND_API_KEY=
# Remitente con el dominio verificado en Resend, p. ej. Tempora <no-responder@tempora.mx>
MAIL_FROM=
# Opcional: a dónde llegan las respuestas (si no, al remitente).
MAIL_REPLY_TO=

# Proveedor de SMS (códigos de acceso e invitaciones por teléfono): "console" imprime el mensaje
# (solo desarrollo; en producción la API no arranca con él) y "twilio" lo envía.
SMS_PROVIDER=console
# Twilio, solo con SMS_PROVIDER=twilio. Los valores reales van en .env, nunca aquí.
TWILIO_ACCOUNT_SID=
# Auth Token de la cuenta, o el secreto de la API key si llenas TWILIO_API_KEY_SID (recomendado en producción).
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
# Remitente: un número en E.164 o un Messaging Service (MG...). Basta uno.
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# Versión vigente del aviso de privacidad. Al cambiarla, cada persona debe aceptarlo de nuevo antes de
# marcar asistencia (ADR 0014).
PRIVACY_NOTICE_VERSION=2026-11-borrador

# Proxies delante de la API, para saber la IP real del cliente (topes de intentos y auditoría).
# Vacío: ninguno (la API recibe las conexiones directo). Detrás del balanceador de una plataforma
# (Railway, Render, Fly...), normalmente 1. También acepta IPs o rangos CIDR separados por coma.
# Nunca "true" si alguien puede llegar a la API sin pasar por el proxy.
TRUST_PROXY=

DB_POOL_MAX=10
AUTH_POOL_MAX=5
